{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://triton-atlas.org/schemas/ttatlas.kernel.v2.schema.json",
  "title": "ttatlas.kernel v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "dram_base",
    "inputs",
    "outputs",
    "grid"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "dram_base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "output"
      ],
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 2147483648,
          "maximum": 4294967295,
          "multipleOf": 1024
        },
        "output": {
          "type": "integer",
          "minimum": 2147483648,
          "maximum": 4294967295,
          "multipleOf": 1024
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/slot"
          },
          {
            "properties": {
              "role": {
                "enum": [
                  "activation_fp8",
                  "weight_fp8_nk",
                  "weight_fp8_kn",
                  "bias_bf16",
                  "mask_bf16",
                  "constant_bf16"
                ]
              }
            }
          }
        ]
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/slot"
          },
          {
            "properties": {
              "role": {
                "const": "output_bf16"
              }
            }
          }
        ]
      }
    },
    "grid": {
      "const": [
        1,
        1,
        1
      ]
    }
  },
  "$defs": {
    "slot": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "index",
            "kind",
            "arg",
            "role",
            "offset",
            "row_stride",
            "col_stride",
            "block",
            "valid",
            "other",
            "vector_layout",
            "transposed",
            "host_dtype",
            "tile_dtype"
          ],
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "block": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32
              },
              "minItems": 4,
              "maxItems": 4
            },
            "valid": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32
              },
              "minItems": 4,
              "maxItems": 4
            },
            "vector_layout": {
              "enum": [
                "none",
                "rows",
                "cols"
              ]
            },
            "transposed": {
              "type": "boolean"
            },
            "host_dtype": {
              "enum": [
                "bf16",
                "f32",
                "f8E4M3FN"
              ]
            },
            "tile_dtype": {
              "enum": [
                "bf16",
                "f8E4M3FN"
              ]
            },
            "kind": {
              "const": "memory"
            },
            "arg": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "role": {
              "type": "string"
            },
            "offset": {
              "type": "integer"
            },
            "row_stride": {
              "type": "integer"
            },
            "col_stride": {
              "type": "integer"
            },
            "other": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 65535
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "index",
            "kind",
            "role",
            "block",
            "valid",
            "pattern",
            "vector_layout",
            "transposed",
            "host_dtype",
            "tile_dtype"
          ],
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "block": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32
              },
              "minItems": 4,
              "maxItems": 4
            },
            "valid": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32
              },
              "minItems": 4,
              "maxItems": 4
            },
            "vector_layout": {
              "enum": [
                "none",
                "rows",
                "cols"
              ]
            },
            "transposed": {
              "type": "boolean"
            },
            "host_dtype": {
              "enum": [
                "bf16",
                "f32",
                "f8E4M3FN"
              ]
            },
            "tile_dtype": {
              "enum": [
                "bf16",
                "f8E4M3FN"
              ]
            },
            "kind": {
              "const": "constant"
            },
            "role": {
              "type": "string"
            },
            "pattern": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "minItems": 1024,
              "maxItems": 1024
            }
          }
        }
      ]
    }
  }
}
